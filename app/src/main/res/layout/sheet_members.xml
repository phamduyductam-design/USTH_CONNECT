<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="@dimen/sheet_height" android:orientation="vertical" android:padding="@dimen/space_20">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView style="@style/Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/members" />
        <ImageButton android:id="@+id/close" style="@style/IconButton" android:src="@drawable/ic_close" android:contentDescription="@string/close" />
    </LinearLayout>
    <TextView android:id="@+id/subtitle" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_16" />
    <EditText android:id="@+id/search" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/search_members" android:inputType="text" android:autofillHints="" android:drawableStart="@drawable/ic_search" android:drawablePadding="@dimen/space_8" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="@dimen/space_12" />
</LinearLayout>
