<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:paddingHorizontal="4dp"
        android:gravity="center_vertical"
        android:background="@color/surface">
        <ImageButton
            android:id="@+id/back"
            style="@style/IconButton"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />
        <TextView
            android:id="@+id/chat_avatar"
            style="@style/Heading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@drawable/bg_chat_header_icon"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:layout_marginEnd="8dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/subtitle"
                style="@style/Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/members"
            style="@style/SmallOutlineButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:minWidth="48dp"
            app:icon="@drawable/ic_members"
            app:iconSize="18dp"
            app:strokeWidth="0dp"
            app:backgroundTint="@color/background"
            android:contentDescription="@string/members" />
        <ImageButton
            android:id="@+id/more"
            style="@style/IconButton"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/options" />
        <include
            layout="@layout/view_theme_toggle" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />
    <TextView
        android:id="@+id/topic"
        style="@style/Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_topic"
        android:padding="12dp"
        android:textSize="14sp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:maxLines="3"
        android:ellipsize="end"
        app:drawableStartCompat="@drawable/ic_info"
        android:drawablePadding="8dp"
        android:textColor="@color/text_secondary" />
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_error"
        android:visibility="gone">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_warning"
            app:tint="@color/error"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/connection_status"
            style="@style/Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/error"
            android:lineSpacingExtra="3dp"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reconnect"
            style="@style/SmallOutlineButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="@string/reconnect"
            app:strokeColor="@color/error"
            android:textColor="@color/error" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="18dp"
                android:background="@drawable/bg_chat_header_icon"
                android:src="@drawable/ic_chat_hash"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/empty_title"
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_empty"
                android:gravity="center"
                android:layout_marginTop="20dp" />
            <TextView
                android:id="@+id/empty_detail"
                style="@style/Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_empty_detail"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </FrameLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/latest"
        style="@style/SmallOutlineButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_gravity="center"
        android:text="@string/latest"
        android:visibility="gone" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:background="@color/surface"
        android:paddingHorizontal="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">
        <ImageButton
            android:id="@+id/chat_commands"
            style="@style/IconButton"
            android:src="@drawable/ic_plus"
            android:contentDescription="@string/chat_commands"
            android:background="@drawable/bg_chat_header_icon" />
        <EditText
            android:id="@+id/composer"
            style="@style/Input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_chat_composer"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:inputType="textMultiLine|textCapSentences"
            android:singleLine="false"
            android:maxLines="5"
            android:imeOptions="flagNoExtractUi"
            android:gravity="center_vertical"
            android:hint="@string/messages"
            android:autofillHints=""
            android:textSize="16sp" />
        <ImageButton
            android:id="@+id/send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="13dp"
            android:background="@drawable/bg_send"
            android:src="@drawable/ic_send"
            android:contentDescription="@string/send" />
    </LinearLayout>
    <TextView
        android:id="@+id/send_hint"
        style="@style/Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" />
</LinearLayout>
