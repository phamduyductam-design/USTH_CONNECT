<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <ImageView
                android:id="@+id/university_logo"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_logo"
                android:src="@drawable/usth_university_logo"
                android:contentDescription="@string/usth" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    style="@style/Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/primary"
                    android:textSize="24sp" />
                <TextView
                    android:id="@+id/tagline"
                    style="@style/Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:layout_marginTop="6dp"
                    android:textSize="14sp" />
            </LinearLayout>
            <include
                layout="@layout/view_theme_toggle" />
        </LinearLayout>
        <TextView
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cp_connect_intro"
            android:lineSpacingExtra="4dp"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_connection_card">
            <TextView
                android:id="@+id/nickname_label"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nickname"
                android:textStyle="bold"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/nickname"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/nickname"
                android:inputType="textVisiblePassword"
                android:autofillHints="username"
                android:imeOptions="actionNext" />
            <TextView
                style="@style/Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cp_nickname_help"
                android:layout_marginTop="8dp"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_connection_card">
            <TextView
                android:id="@+id/server_label"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cp_server_title"
                android:textStyle="bold"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/host"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/server_hint"
                android:inputType="textUri"
                android:autofillHints=""
                android:imeOptions="actionDone" />
            <TextView
                android:id="@+id/server_summary"
                style="@style/Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/advanced_toggle"
                style="@style/OutlineButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/cp_advanced"
                android:gravity="start|center_vertical"
                app:strokeWidth="0dp"
                app:icon="@drawable/ic_settings"
                app:iconSize="20dp"
                app:iconTint="@color/primary" />
            <LinearLayout
                android:id="@+id/advanced_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:id="@+id/port_label"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/port"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/port"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/port"
                    android:inputType="number"
                    android:autofillHints="" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/tls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/tls"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/username_label"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cp_username"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/username"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/cp_username"
                    android:inputType="textVisiblePassword"
                    android:autofillHints="" />
                <TextView
                    android:id="@+id/realname_label"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/cp_real_name"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/real_name"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/cp_real_name"
                    android:inputType="textPersonName"
                    android:autofillHints="" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/connect"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/connect"
            android:textSize="16sp"
            app:icon="@drawable/ic_server"
            app:iconGravity="textStart"
            app:iconSize="20dp" />
        <TextView
            android:id="@+id/server_note"
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cp_server_help"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textSize="13sp" />
        <LinearLayout
            android:id="@+id/connect_status_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_selected"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/status"
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:textSize="14sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel"
                style="@style/OutlineButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/cancel"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
