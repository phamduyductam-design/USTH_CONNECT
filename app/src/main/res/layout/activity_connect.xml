<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/university_logo"
                android:layout_width="92dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="3dp"
                android:background="@drawable/bg_logo"
                android:src="@drawable/usth_university_logo"
                android:contentDescription="@string/usth" />
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <include
                layout="@layout/theme_toggle" />
        </LinearLayout>
        <TextView
            android:id="@+id/logo_usth"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/usth"
            android:gravity="center"
            android:textColor="@color/primary"
            android:textSize="@dimen/logo_size"
            android:layout_marginTop="@dimen/space_32" />
        <View
            android:layout_width="@dimen/underline_width"
            android:layout_height="@dimen/underline_height"
            android:layout_gravity="center"
            android:background="@color/brand_red" />
        <TextView
            android:id="@+id/logo_connect"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_word"
            android:gravity="center"
            android:textSize="@dimen/logo_connect_size" />
        <TextView
            android:id="@+id/tagline"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_8" />
        <ImageView
            android:layout_width="@dimen/row_height"
            android:layout_height="@dimen/row_height"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_24"
            android:padding="@dimen/space_16"
            android:background="@drawable/bg_selected"
            android:src="@drawable/ic_chat_hash"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/nickname_label"
            style="@style/Caption"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nickname" />
        <EditText
            android:id="@+id/nickname"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nickname"
            android:inputType="textVisiblePassword"
            android:autofillHints="username" />
        <TextView
            android:id="@+id/server_label"
            style="@style/Caption"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server"
            android:layout_marginTop="@dimen/space_16" />
        <EditText
            android:id="@+id/host"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_hint"
            android:autofillHints=""
            android:inputType="textUri" />
        <TextView
            android:id="@+id/server_note"
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_note_short"
            android:layout_marginTop="@dimen/space_8" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/advanced_toggle"
                style="@style/OutlineButton"
                app:strokeColor="@color/outline"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/text_secondary"
                app:iconSize="18dp"
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/advanced" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_down"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/advanced_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/port_label"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/port"
                android:layout_marginTop="@dimen/space_16" />
            <EditText
                android:id="@+id/port"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/port"
                android:autofillHints=""
                android:inputType="number" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/tls"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch"
                android:text="@string/tls" />
            <TextView
                android:id="@+id/username_label"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/username" />
            <EditText
                android:id="@+id/username"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/username"
                android:autofillHints=""
                android:inputType="textVisiblePassword" />
            <TextView
                android:id="@+id/realname_label"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/real_name"
                android:layout_marginTop="@dimen/space_16" />
            <EditText
                android:id="@+id/real_name"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/real_name"
                android:autofillHints=""
                android:inputType="textPersonName" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/connect_status_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_selected"
            android:layout_marginTop="12dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/status"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:accessibilityLiveRegion="polite" />
            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="@dimen/touch"
                android:layout_height="@dimen/touch"
                android:layout_gravity="center"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel"
                style="@style/OutlineButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:visibility="gone" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/connect"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect"
            android:layout_marginTop="@dimen/space_16" />
        <TextView
            android:id="@+id/footer"
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_footer"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_8" />
    </LinearLayout>
</ScrollView>
