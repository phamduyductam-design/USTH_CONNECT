<resources>
    <style name="Base.Theme.UsthConnect" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorSecondary">@color/badge</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.UsthConnect" parent="Base.Theme.UsthConnect" />
    <style name="Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/body_size</item>
    </style>
    <style name="Caption" parent="Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/caption_size</item>
    </style>
    <style name="Heading" parent="Body">
        <item name="android:textSize">@dimen/heading_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Title" parent="Heading">
        <item name="android:textSize">@dimen/title_size</item>
    </style>
    <style name="Input" parent="Body">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:padding">@dimen/space_12</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/input_radius</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/body_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="OutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/input_radius</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
    </style>
    <style name="IconButton">
        <item name="android:layout_width">@dimen/touch</item>
        <item name="android:layout_height">@dimen/touch</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/space_12</item>
    </style>
</resources>
