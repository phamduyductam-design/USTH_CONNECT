<resources>
    <style name="Base.Theme.UsthConnect" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialAlertDialogTheme">@style/PreviewDialog</item>
        <item name="bottomSheetDialogTheme">@style/PreviewBottomSheetDialog</item>
    </style>
    <style name="Theme.UsthConnect" parent="Base.Theme.UsthConnect" />
    <style name="Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/body_size</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Caption" parent="Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/caption_size</item>
    </style>
    <style name="Heading" parent="Body">
        <item name="android:textSize">@dimen/heading_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Title" parent="Heading">
        <item name="android:textSize">@dimen/title_size</item>
    </style>
    <style name="Input" parent="Body">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:padding">@dimen/space_12</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="SearchInput" parent="Input">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/input_radius</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="OutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/input_radius</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="SmallOutlineButton" parent="OutlineButton">
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="cornerRadius">4dp</item>
        <item name="strokeColor">@color/outline</item>
    </style>
    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">14dp</item>
        <item name="android:tint">@color/text_primary</item>
    </style>
    <style name="SectionLabel" parent="Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="NavLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="NavLabelActive" parent="NavLabel">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PreviewDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogCorners</item>
        <item name="colorPrimary">@color/primary</item>
    </style>
    <style name="DialogCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="PreviewBottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/PreviewBottomSheet</item>
    </style>
    <style name="PreviewBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/SheetCorners</item>
        <item name="backgroundTint">@color/surface</item>
    </style>
    <style name="SheetCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
